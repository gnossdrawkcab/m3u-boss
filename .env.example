# Required. Generate with: openssl rand -base64 32
M3U_BOSS_ADMIN_PASSWORD=replace-with-a-long-random-password
M3U_BOSS_ADMIN_USERNAME=admin
# Required for /m3u and /epg URLs. Generate a second independent value.
M3U_BOSS_FEED_TOKEN=replace-with-another-long-random-token

# URL players use to reach this server.
M3U_BOSS_PUBLIC_URL=http://192.168.1.10:43817
M3U_BOSS_PORT=43817

# Optional comma-separated browser origins. Leave empty for same-origin only.
M3U_BOSS_CORS_ORIGINS=

# Optional JSON mapping applied to stream URLs during export.
M3U_BOSS_STREAM_REWRITES={}

# Optional edge/Dispatcharr deployment settings (compose.edge.yaml only).
DISPATCHARR_EPG_URL=
DISP_EPG_REFRESH_MIN=30
UI_REQUIRE_CF_ACCESS=false
